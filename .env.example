# ============================================================
# LANDGUARD AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit your real .env file to GitHub.

# OpenWeatherMap API key (free tier — 60 calls/min)
# Get one at: https://openweathermap.org/api
# If not set, the app automatically uses fallback demo data.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Future: Ground movement sensor API URL
# VITE_GROUND_MOVEMENT_API_URL=

# Future: Soil moisture remote-sensing API URL
# VITE_SOIL_MOISTURE_API_URL=

# ============================================================
# NASA GPM IMERG Precipitation Integration
# ============================================================
# NASA IMERG data is accessed through a Supabase Edge Function
# proxy (supabase/functions/imerg-precipitation).
#
# The NASA Earthdata Bearer token is stored as a Supabase secret
# named NASA_EARTHDATA_TOKEN — it is NEVER in frontend code.
#
# To configure:
# 1. Create a free NASA Earthdata account: https://urs.earthdata.nasa.gov/
# 2. Generate a token in your Earthdata account settings
# 3. Set it as a Supabase Edge Function secret:
#    Go to your Supabase dashboard → Edge Functions → Secrets
#    Add: NASA_EARTHDATA_TOKEN = <your_token>
#
# If no token is set, the app uses fallback precipitation data
# and clearly labels it as FALLBACK — never as NASA data.

# ============================================================
# Supabase (auto-configured in this environment)
# ============================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
